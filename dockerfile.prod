# Dependencies Stage
FROM node:24-slim AS deps

# Instala solo lo necesario para compilar (build-essential incluye make/g++/python)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    libpixman-1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY package.json ./
COPY package-lock.json ./

RUN npm ci --legacy-peer-deps

# Build Stage
FROM node:24-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    libpixman-1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY --from=deps /usr/src/app/node_modules ./node_modules
COPY . .

RUN npm run build

# Limpia dev deps (solo prune basta)
RUN npm prune --production && npm cache clean --force

# Production Stage (más ligera)
FROM node:24-slim AS production

# Solo runtime libs (sin -dev)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libcairo2 \
    libpango-1.0-0 \
    libjpeg62-turbo \
    libgif7 \
    librsvg2-2 \
    libpixman-1-0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY --from=builder /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/assets ./assets

# Crea carpeta para assets y permisos
RUN mkdir -p /usr/src/app/assets && chown -R node:node /usr/src/app/assets

ENV NODE_ENV=production

USER node

EXPOSE 3006

CMD ["node", "dist/main.js"]